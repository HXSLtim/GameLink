# Auto detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicitly declare text files
*.go text
*.md text
*.yaml text
*.yml text
*.json text
*.txt text
*.sh text
*.ps1 text
*.tsx text
*.ts text
*.jsx text
*.js text
*.css text
*.scss text
*.html text

# Declare files that will always have CRLF line endings on checkout
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Denote all files that are truly binary and should not be modified
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary

# Exclude node_modules and dependencies
node_modules/** -text
vendor/** -text
