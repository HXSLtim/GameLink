# GameLink Environment Variables Template
# Copy this file to .env and fill in the actual values
# IMPORTANT: Never commit .env file to version control

# =============================================================================
# Application Environment
# =============================================================================
APP_ENV=production
# Options: development, production, staging

# =============================================================================
# Server Configuration
# =============================================================================
SERVICE_PORT=8080
ENABLE_SWAGGER=false

# =============================================================================
# Database Configuration
# =============================================================================
DB_TYPE=postgres
# Options: postgres, sqlite

# PostgreSQL DSN format:
# host=localhost port=5432 user=gamelink password=your-password dbname=gamelink sslmode=disable
DB_DSN=

# Database Connection Pool (optional)
DB_MAX_CONNS=25
DB_MAX_IDLE=5

# Read Replicas (optional, for read-write splitting)
# Comma-separated list of reader DSNs
DB_READER_DSNS=

# =============================================================================
# Cache Configuration
# =============================================================================
CACHE_TYPE=redis
# Options: redis, memory

# Redis Configuration
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0

# =============================================================================
# Security: Encryption Configuration
# =============================================================================
# IMPORTANT: For production, encryption MUST be enabled
CRYPTO_ENABLED=true

# AES-256-CBC Encryption Keys (REQUIRED when CRYPTO_ENABLED=true)
# Secret Key must be exactly 32 bytes (base64 encoded)
# Generate with: openssl rand -base64 32
CRYPTO_SECRET_KEY=your-32-byte-secret-key-here-change-in-production

# Initialization Vector must be exactly 16 bytes (base64 encoded)
# Generate with: openssl rand -base64 16
CRYPTO_IV=your-16-byte-iv-here-change-in-production

# HTTP Methods to Encrypt
CRYPTO_METHODS=POST,PUT,PATCH

# Paths to Exclude from Encryption (comma-separated)
CRYPTO_EXCLUDE_PATHS=/api/v1/health,/api/v1/ping,/api/v1/auth/refresh

# Use SHA-256 Signature
CRYPTO_USE_SIGNATURE=true

# =============================================================================
# Security: JWT Authentication
# =============================================================================
# JWT Secret Key (REQUIRED in production)
# Minimum 32 characters recommended (16 minimum)
# Generate with: openssl rand -base64 32
JWT_SECRET_KEY=your-jwt-secret-key-minimum-32-characters

# JWT Token Time-to-Live (hours)
JWT_TOKEN_TTL_HOURS=24

# =============================================================================
# Super Admin Configuration
# =============================================================================
SUPER_ADMIN_EMAIL=admin@gamelink.com
# Password requirements: At least 8 characters with uppercase, lowercase, number, special character
# Generate with: openssl rand -base64 24
SUPER_ADMIN_PASSWORD=your-super-admin-password-here

SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_PHONE=

# =============================================================================
# Admin Authentication Mode
# =============================================================================
ADMIN_AUTH_MODE=jwt
# Options: jwt, admin (admin mode uses admin-specific authentication)

# =============================================================================
# Data Seeding
# =============================================================================
# Enable seeding of demo data (usually false in production)
SEED_ENABLED=false

# =============================================================================
# External API: WeChat Pay (Optional)
# =============================================================================
WECHAT_PAY_APP_ID=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_API_KEY=
WECHAT_PAY_API_CERT_PATH=
WECHAT_PAY_NOTIFY_URL=
WECHAT_PAY_ENABLED=false

# =============================================================================
# External API: Alipay (Optional)
# =============================================================================
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY_PATH=
ALIPAY_PUBLIC_KEY_PATH=
ALIPAY_NOTIFY_URL=
ALIPAY_ENABLED=false

# =============================================================================
# External API: SMS Service (Optional)
# =============================================================================
SMS_PROVIDER=
# Options: aliyun, tencent
SMS_ACCESS_KEY=
SMS_SECRET_KEY=
SMS_SIGN_NAME=
SMS_ENABLED=false

# =============================================================================
# External API: OSS Object Storage (Optional)
# =============================================================================
OSS_PROVIDER=
# Options: aliyun, qcloud, minio
OSS_ENDPOINT=
OSS_ACCESS_KEY=
OSS_SECRET_KEY=
OSS_BUCKET=
OSS_REGION=
OSS_ENABLED=false

# =============================================================================
# Security Notes
# =============================================================================
# 1. Never commit actual .env file to version control
# 2. Use strong, unique passwords for production
# 3. All crypto keys must be properly sized:
#    - CRYPTO_SECRET_KEY: exactly 32 bytes (base64 encoded = 44 chars)
#    - CRYPTO_IV: exactly 16 bytes (base64 encoded = 24 chars)
# 4. Rotate keys and credentials regularly
# 5. Use different credentials for different environments
# 6. Store credentials securely in production (e.g., Kubernetes secrets, AWS Secrets Manager)
