# GameLink 环境变量配置示例
# 复制此文件为 .env 并修改相应的值

# ==================== 数据库配置 ====================
# PostgreSQL 数据库名称
POSTGRES_DB=gamelink

# PostgreSQL 用户名
POSTGRES_USER=gamelink

# PostgreSQL 密码（生产环境请使用强密码）
POSTGRES_PASSWORD=your-strong-password-here

# ==================== Redis 配置 ====================
# Redis 密码（生产环境请使用强密码）
REDIS_PASSWORD=your-redis-password-here

# ==================== JWT 配置 ====================
# JWT 密钥（至少32字符，生产环境必须修改）
# 生成方式: openssl rand -base64 32
JWT_SECRET_KEY=your-jwt-secret-key-min-32-chars

# ==================== 加密配置 ====================
# 数据加密密钥（必须24字符）
# 生成方式: openssl rand -base64 24 | cut -c1-24
CRYPTO_SECRET_KEY=GameLink2025SecretKey

# 加密初始化向量（必须16字符）
CRYPTO_IV=GameLink2025IV!!

# ==================== 管理员配置 ====================
# 超级管理员邮箱
SUPER_ADMIN_EMAIL=admin@gamelink.com

# 超级管理员密码（生产环境必须使用强密码）
SUPER_ADMIN_PASSWORD=your-admin-password-here

# ==================== 其他配置 ====================
# 应用环境 (development/production)
APP_ENV=production

# 服务端口
SERVICE_PORT=8080
