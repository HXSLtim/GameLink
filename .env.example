# GameLink 环境变量模板
# 复制此文件为 .env 并填入实际值
# 重要: 永远不要将 .env 文件提交到版本控制

# =============================================================================
# 应用环境
# =============================================================================
APP_ENV=development
# 选项: development, staging, production

GIN_MODE=debug
# 选项: debug, release, test

# =============================================================================
# 服务端口配置
# =============================================================================
BACKEND_PORT=8080
ADMIN_PORT=80
ADMIN_HTTP_PORT=80
ADMIN_HTTPS_PORT=443

# =============================================================================
# 数据库配置 (PostgreSQL)
# =============================================================================
POSTGRES_USER=gamelink
POSTGRES_PASSWORD=<set-strong-postgres-password>
POSTGRES_DB=gamelink
POSTGRES_PORT=5433

# 连接池配置
DB_MAX_CONNS=25
DB_MAX_IDLE=5

# 读写分离 (高可用模式，可选)
# DB_READER_DSNS=host=postgres-replica port=5432 ...

# =============================================================================
# 缓存配置 (Redis)
# =============================================================================
CACHE_TYPE=redis
# 选项: redis, memory

REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=<set-strong-redis-password>
REDIS_DB=0
REDIS_PORT=6380

# =============================================================================
# 安全: 加密配置
# =============================================================================
# 重要: 生产环境必须启用加密
CRYPTO_ENABLED=false
# 开发环境: false, 生产环境: true

# AES-256-CBC 加密密钥 (CRYPTO_ENABLED=true 时必填)
# Secret Key 必须是 32 字节 (base64 编码后约 44 字符)
# 生成命令: openssl rand -base64 32
CRYPTO_SECRET_KEY=

# 初始化向量必须是 16 字节 (base64 编码后约 24 字符)
# 生成命令: openssl rand -base64 16
CRYPTO_IV=

# 使用 SHA-256 签名验证（提高安全性）
# 前端配置项：VITE_CRYPTO_USE_SIGNATURE（admin/.env.production）
# 开发环境：false（可选），生产环境：true（推荐）
# 注意：前后端签名配置必须保持一致
CRYPTO_USE_SIGNATURE=false

# =============================================================================
# 安全: JWT 认证
# =============================================================================
# JWT 密钥 (生产环境必填，建议 32+ 字符)
# 生成命令: openssl rand -base64 32
JWT_SECRET_KEY=<set-32-plus-char-random-secret>

# JWT Token 有效期 (小时)
JWT_TOKEN_TTL_HOURS=24

# =============================================================================
# 超级管理员配置
# =============================================================================
SUPER_ADMIN_EMAIL=admin@gamelink.com
# 密码要求: 至少 8 字符，包含大小写字母、数字
# 生成命令: openssl rand -base64 24
SUPER_ADMIN_PASSWORD=<set-strong-admin-password>
SUPER_ADMIN_NAME=Super Admin

# =============================================================================
# 种子数据
# =============================================================================
# 是否初始化演示数据 (生产环境应为 false)
SEED_ENABLED=true

# =============================================================================
# 外部 API: 微信小程序 (可选)
# =============================================================================
# 微信小程序 AppID 和 Secret
# 获取方式: 微信公众平台 -> 开发 -> 开发管理 -> 开发设置
WECHAT_APPID=
WECHAT_SECRET=

# =============================================================================
# 外部 API: 微信支付 (可选)
# =============================================================================
WECHAT_PAY_ENABLED=false
# 获取方式: 微信商户平台 -> 账户中心 -> API 安全
WECHAT_PAY_APP_ID=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_API_KEY=
WECHAT_PAY_CERT_PATH=/app/certs/wechat/apiclient_cert.p12
WECHAT_PAY_KEY_PATH=/app/certs/wechat/apiclient_key.pem
WECHAT_PAY_CERT_SERIAL_NO=
# 回调地址（必须是 HTTPS）
# 生产环境: https://api.gamelink.com/api/v1/payments/wechat/notify
# Staging: https://staging.gamelink.com/api/v1/payments/wechat/notify
WECHAT_PAY_NOTIFY_URL=https://api.gamelink.com/api/v1/payments/wechat/notify

# =============================================================================
# 外部 API: 支付宝 (可选)
# =============================================================================
ALIPAY_ENABLED=false
# 获取方式: 支付宝开放平台 -> 创建应用
ALIPAY_APP_ID=
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
ALIPAY_PRIVATE_KEY_PATH=/app/certs/alipay/app_private_key.pem
ALIPAY_PUBLIC_KEY_PATH=/app/certs/alipay/app_public_key.pem
# 回调地址（必须是 HTTPS）
# 生产环境: https://api.gamelink.com/api/v1/payments/alipay/notify
# Staging: https://staging.gamelink.com/api/v1/payments/alipay/notify
ALIPAY_NOTIFY_URL=https://api.gamelink.com/api/v1/payments/alipay/notify

# =============================================================================
# 外部 API: 短信服务 (可选)
# =============================================================================
SMS_PROVIDER=
# 选项: aliyun, tencent
SMS_ACCESS_KEY=
SMS_SECRET_KEY=
SMS_SIGN_NAME=
SMS_ENABLED=false

# =============================================================================
# 外部 API: 对象存储 (可选)
# =============================================================================
OSS_PROVIDER=
# 选项: aliyun, qcloud, minio
OSS_ENDPOINT=
OSS_ACCESS_KEY=
OSS_SECRET_KEY=
OSS_BUCKET=
OSS_REGION=
OSS_ENABLED=false
OSS_SIGNED_URL_TTL_SECONDS=3600

# =============================================================================
# 环境差异说明
# =============================================================================
# 
# | 配置项          | 开发环境      | 生产环境      | 高可用生产    |
# |-----------------|---------------|---------------|---------------|
# | CRYPTO_ENABLED  | false         | true          | true          |
# | SEED_ENABLED    | true          | false         | false         |
# | GIN_MODE        | debug         | release       | release       |
# | 数据库实例      | 单实例        | 单实例        | 主从复制      |
# | 后端实例        | 1             | 1             | 2+            |
# | 资源限制        | 无            | 有            | 有            |
#
# =============================================================================
# 安全提示
# =============================================================================
# 1. 永远不要将 .env 文件提交到版本控制
# 2. 生产环境使用强密码
# 3. 加密密钥必须正确设置:
#    - CRYPTO_SECRET_KEY: 32 字节 (base64 编码 = 44 字符)
#    - CRYPTO_IV: 16 字节 (base64 编码 = 24 字符)
# 4. 定期轮换密钥和凭证
# 5. 不同环境使用不同凭证
# 6. 生产环境安全存储凭证 (如 Kubernetes secrets, AWS Secrets Manager)
