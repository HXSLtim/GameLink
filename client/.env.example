# GameLink Client Environment Configuration
# Copy this file to .env.local and fill in the actual values

# ============ API Configuration ============
# Backend API base URL (development uses vite proxy, production needs full URL)
VITE_API_BASE_URL=/api/v1

# WebSocket server URL (for real-time features)
VITE_WS_URL=ws://localhost:8080/ws

# Application environment
VITE_APP_ENV=development

# ============ Security Configuration ============
# Enable request/response encryption (production only)
# Set to 'true' in production, 'false' in development
VITE_CRYPTO_ENABLED=false

# AES-256-CBC encryption configuration (REQUIRED if CRYPTO_ENABLED=true)
# Generate secure random values for production deployment
# Secret key must be exactly 32 characters (256 bits)
VITE_CRYPTO_SECRET_KEY=your-32-char-secret-key-here

# Initialization vector must be exactly 16 characters (128 bits)
VITE_CRYPTO_IV=your-16-char-iv-here

# ============ Feature Flags ============
# Enable Mock data for development debugging
VITE_ENABLE_MOCK=false

# ============ Third-Party Services ============
# Sentry DSN (optional, for error tracking)
VITE_SENTRY_DSN=

# Analytics ID (optional, Baidu Analytics/Google Analytics)
VITE_ANALYTICS_ID=

# ============ Additional Security Configuration ============
# See .env.security for complete security options
# Content Security Policy
VITE_CSP_ENABLED=true
VITE_CSP_POLICY={"default-src":"'self'","script-src":"'self' 'unsafe-inline' 'unsafe-eval'","style-src":"'self' 'unsafe-inline'","img-src":"'self' data: https:","connect-src":"'self'","font-src":"'self' data:","object-src":"'none'"}

# Token storage (localStorage | sessionStorage | memory)
VITE_TOKEN_STORAGE=localStorage

# Token refresh buffer (seconds before expiry)
VITE_TOKEN_REFRESH_BUFFER=300

# Security headers
VITE_HSTS_ENABLED=true
VITE_NO_SNIFF_ENABLED=true
VITE_FRAME_OPTIONS=DENY
VITE_XSS_PROTECTION_ENABLED=true

# API security
VITE_REQUIRE_HTTPS=true
VITE_API_TIMEOUT=30000
VITE_RATE_LIMIT_PER_MINUTE=60

# File upload security
VITE_MAX_FILE_SIZE=10485760
VITE_ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,image/webp

# Session security
VITE_SESSION_TIMEOUT=86400000
VITE_IDLE_TIMEOUT=1800000
VITE_SESSION_TIMEOUT_WARNING=300000

# Security logging (development)
VITE_SECURITY_LOGGING_ENABLED=true
VITE_SECURITY_WARNINGS=true
VITE_LOG_API_REQUESTS=true

# External link security
VITE_EXTERNAL_LINK_WARNING=true
VITE_TRUSTED_DOMAINS=gamelink.com,api.gamelink.com

# ============ Development Notes ============
#
# Security Requirements for Production:
# - CRYPTO_ENABLED must be 'true'
# - CRYPTO_SECRET_KEY must be a cryptographically secure random value (32 chars)
# - CRYPTO_IV must be a cryptographically secure random value (16 chars)
# - API_BASE_URL must use HTTPS (https://api.example.com/api/v1)
# - CSP_ENABLED must be 'true'
# - REQUIRE_HTTPS must be 'true'
#
# Generate secure values:
# - Secret key: `openssl rand -base64 32` (then take first 32 chars)
# - IV: `openssl rand -base64 16` (then take first 16 chars)
#
# For complete security configuration, refer to:
# - docs/CLIENT_SECURITY_GUIDE.md
# - .env.security (detailed security options)
