# GameLink Client 环境变量
# 复制此文件为 .env.local 并填入实际值

# API 基础路径（开发环境通过 vite proxy 代理，生产环境需要配置）
VITE_API_BASE_URL=/api/v1

# WebSocket 地址
VITE_WS_URL=ws://localhost:8080/ws

# 应用环境
VITE_APP_ENV=development

# 是否启用 Mock 数据（开发调试用）
VITE_ENABLE_MOCK=false

# Sentry DSN（可选，用于错误追踪）
VITE_SENTRY_DSN=

# 百度统计/Google Analytics ID（可选）
VITE_ANALYTICS_ID=
