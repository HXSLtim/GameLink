{
    "extends": "./tsconfig.app.json",
    "compilerOptions": {
        "composite": true,
        "noEmit": true,
        "types": [
            "node",
            "vitest/globals",
            "@testing-library/jest-dom",
            "vite/client"
        ],
        "baseUrl": ".",
        "paths": {
            "@/*": [
                "./src/*"
            ]
        }
    },
    "include": [
        "src/**/*.test.ts",
        "src/**/*.test.tsx",
        "src/**/__tests__/*",
        "src/test/*",
        "src/test/setup.ts",
        "src/**/*"
    ],
    "exclude": [
        "node_modules"
    ]
}