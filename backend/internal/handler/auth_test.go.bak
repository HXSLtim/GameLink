package handler

import (
	"context"
	"errors"
	"net/http"
	"net/http/httptest"
	"strings"
	"testing"
	"time"

	"github.com/gin-gonic/gin"
	"github.com/stretchr/testify/assert"
	"github.com/stretchr/testify/mock"
	"github.com/stretchr/testify/require"

	"gamelink/internal/auth"
	"gamelink/internal/model"
	"gamelink/internal/repository"
	"gamelink/internal/service"
	authservice "gamelink/internal/service/auth"
)

// MockAuthService 模拟认证服务
type MockAuthService struct {
	mock.Mock
}

func (m *MockAuthService) GetUser(ctx context.Context, id uint64) (*model.User, error) {
	args := m.Called(ctx, id)
	if args.Get(0) == nil {
		return nil, args.Error(1)
	}
	return args.Get(0).(*model.User), args.Error(1)
}

func (m *MockAuthService) Me(ctx context.Context, authorizationHeader string) (*model.User, error) {
	args := m.Called(ctx, authorizationHeader)
	if args.Get(0) == nil {
		return nil, args.Error(1)
	}
	return args.Get(0).(*model.User), args.Error(1)
}

func (m *MockAuthService) Login(ctx context.Context, req authservice.LoginRequest) (*authservice.LoginResponse, error) {
	args := m.Called(ctx, req)
	if args.Get(0) == nil {
		return nil, args.Error(1)
	}
	return args.Get(0).(*authservice.LoginResponse), args.Error(1)
}

func (m *MockAuthService) Register(ctx context.Context, req authservice.RegisterRequest) (*authservice.LoginResponse, error) {
	args := m.Called(ctx, req)
	if args.Get(0) == nil {
		return nil, args.Error(1)
	}
	return args.Get(0).(*authservice.LoginResponse), args.Error(1)
}

func (m *MockAuthService) RefreshToken(ctx context.Context, tokenString string) (string, error) {
	args := m.Called(ctx, tokenString)
	return args.String(0), args.Error(1)
}

func TestLoginHandler(t *testing.T) {
	gin.SetMode(gin.TestMode)

	tests := []struct {
		name           string
		requestBody    string
		setupMock      func(*MockAuthService)
		expectedStatus int
		expectedMsg    string
		checkResponse  func(*testing.T, map[string]interface{})
	}{
		{
			name:        "登录成功",
			requestBody: `{"username":"user@example.com","password":"password123"}`,
			setupMock: func(m *MockAuthService) {
				m.On("Login", mock.Anything, authservice.LoginRequest{
					Username: "user@example.com",
					Password: "password123",
				}).Return(&authservice.LoginResponse{
					Token:     "test-token",
					ExpiresAt: time.Now().Add(24 * time.Hour),
					User: model.User{
						Email: "user@example.com",
						Name:  "Test User",
					},
				}, nil).Once()
			},
			expectedStatus: http.StatusOK,
			expectedMsg:    "success",
			checkResponse: func(t *testing.T, response map[string]interface{}) {
				data := response["extensions"].(map[string]interface{})["data"].(map[string]interface{})
				assert.Equal(t, "test-token", data["token"])
				assert.NotNil(t, data["expires_at"])
			},
		},
		{
			name:        "无效请求格式",
			requestBody: `{"username":"user@example.com"`, // 缺少闭合括号
			setupMock:   func(m *MockAuthService) {},
			expectedStatus: http.StatusBadRequest,
			expectedMsg:    "无效的请求格式",
		},
		{
			name:        "用户名或密码错误",
			requestBody: `{"username":"user@example.com","password":"wrongpass"}`,
			setupMock: func(m *MockAuthService) {
				m.On("Login", mock.Anything, authservice.LoginRequest{
					Username: "user@example.com",
					Password: "wrongpass",
				}).Return(nil, service.ErrInvalidCredentials).Once()
			},
			expectedStatus: http.StatusUnauthorized,
			expectedMsg:    "用户名或密码错误",
		},
		{
			name:        "账号被禁用",
			requestBody: `{"username":"user@example.com","password":"password123"}`,
			setupMock: func(m *MockAuthService) {
				m.On("Login", mock.Anything, authservice.LoginRequest{
					Username: "user@example.com",
					Password: "password123",
				}).Return(nil, service.ErrUserDisabled).Once()
			},
			expectedStatus: http.StatusForbidden,
			expectedMsg:    "账号已被禁用",
		},
		{
			name:        "缺少用户名",
			requestBody: `{"password":"password123"}`,
			setupMock:   func(m *MockAuthService) {},
			expectedStatus: http.StatusBadRequest,
			expectedMsg:    "无效的请求格式",
		},
		{
			name:        "缺少密码",
			requestBody: `{"username":"user@example.com"}`,
			setupMock:   func(m *MockAuthService) {},
			expectedStatus: http.StatusBadRequest,
			expectedMsg:    "无效的请求格式",
		},
	}

	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			mockSvc := new(MockAuthService)
			tt.setupMock(mockSvc)

			router := gin.New()
			RegisterAuthRoutes(router, mockSvc)

			req := httptest.NewRequest(http.MethodPost, "/auth/login", strings.NewReader(tt.requestBody))
			req.Header.Set("Content-Type", "application/json")
			w := httptest.NewRecorder()

			router.ServeHTTP(w, req)

			assert.Equal(t, tt.expectedStatus, w.Code)
			
			var response map[string]interface{}
			err := json.Unmarshal(w.Body.Bytes(), &response)
			require.NoError(t, err)
			
			assert.Contains(t, response["message"].(string), tt.expectedMsg)
			
			if tt.checkResponse != nil {
				tt.checkResponse(t, response)
			}

			mockSvc.AssertExpectations(t)
		})
	}
}

func TestRegisterHandler(t *testing.T) {
	gin.SetMode(gin.TestMode)

	tests := []struct {
		name           string
		requestBody    string
		setupMock      func(*MockAuthService)
		expectedStatus int
		expectedMsg    string
	}{
		{
			name:        "注册成功",
			requestBody: `{"email":"newuser@example.com","password":"password123","name":"New User"}`,
			setupMock: func(m *MockAuthService) {
				m.On("Register", mock.Anything, authservice.RegisterRequest{
					Email:    "newuser@example.com",
					Password: "password123",
					Name:     "New User",
					Role:     model.RoleUser,
				}).Return(&authservice.LoginResponse{
					Token:     "new-token",
					ExpiresAt: time.Now().Add(24 * time.Hour),
					User: model.User{
						Email: "newuser@example.com",
						Name:  "New User",
					},
				}, nil).Once()
			},
			expectedStatus: http.StatusOK,
			expectedMsg:    "success",
		},
		{
			name:        "无效请求格式",
			requestBody: `{"email":"newuser@example.com"`, // 缺少闭合括号
			setupMock:   func(m *MockAuthService) {},
			expectedStatus: http.StatusBadRequest,
			expectedMsg:    "无效的请求格式",
		},
		{
			name:        "注册失败-邮箱已存在",
			requestBody: `{"email":"existing@example.com","password":"password123","name":"Test User"}`,
			setupMock: func(m *MockAuthService) {
				m.On("Register", mock.Anything, authservice.RegisterRequest{
					Email:    "existing@example.com",
					Password: "password123",
					Name:     "Test User",
					Role:     model.RoleUser,
				}).Return(nil, errors.New("email already registered")).Once()
			},
			expectedStatus: http.StatusBadRequest,
			expectedMsg:    "注册失败",
		},
		{
			name:           "缺少姓名",
			requestBody:    `{"email":"user@example.com","password":"password123"}`,
			setupMock:      func(m *MockAuthService) {},
			expectedStatus: http.StatusBadRequest,
			expectedMsg:    "无效的请求格式",
		},
		{
			name:           "缺少密码",
			requestBody:    `{"email":"user@example.com","name":"Test User"}`,
			setupMock:      func(m *MockAuthService) {},
			expectedStatus: http.StatusBadRequest,
			expectedMsg:    "无效的请求格式",
		},
		{
			name:           "密码太短",
			requestBody:    `{"email":"user@example.com","password":"123","name":"Test User"}`,
			setupMock:      func(m *MockAuthService) {},
			expectedStatus: http.StatusBadRequest,
			expectedMsg:    "无效的请求格式",
		},
	}

	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			mockSvc := new(MockAuthService)
			tt.setupMock(mockSvc)

			router := gin.New()
			RegisterAuthRoutes(router, mockSvc)

			req := httptest.NewRequest(http.MethodPost, "/auth/register", strings.NewReader(tt.requestBody))
			req.Header.Set("Content-Type", "application/json")
			w := httptest.NewRecorder()

			router.ServeHTTP(w, req)

			assert.Equal(t, tt.expectedStatus, w.Code)
			
			var response map[string]interface{}
			err := json.Unmarshal(w.Body.Bytes(), &response)
			require.NoError(t, err)
			
			assert.Contains(t, response["message"].(string), tt.expectedMsg)

			mockSvc.AssertExpectations(t)
		})
	}
}

func TestMeHandler(t *testing.T) {
	gin.SetMode(gin.TestMode)

	tests := []struct {
		name           string
		authHeader     string
		setupMock      func(*MockAuthService)
		expectedStatus int
		expectedMsg    string
	}{
		{
			name:       "获取当前用户成功",
			authHeader: "Bearer valid-token",
			setupMock: func(m *MockAuthService) {
				m.On("Me", mock.Anything, "Bearer valid-token").Return(&model.User{
					Email: "user@example.com",
					Name:  "Test User",
				}, nil).Once()
			},
			expectedStatus: http.StatusOK,
			expectedMsg:    "success",
		},
		{
			name:           "缺少Authorization头",
			authHeader:     "",
			setupMock:      func(m *MockAuthService) {},
			expectedStatus: http.StatusUnauthorized,
			expectedMsg:    "认证失败",
		},
		{
			name:       "无效的Token",
			authHeader: "Bearer invalid-token",
			setupMock: func(m *MockAuthService) {
				m.On("Me", mock.Anything, "Bearer invalid-token").Return(nil, errors.New("invalid token")).Once()
			},
			expectedStatus: http.StatusUnauthorized,
			expectedMsg:    "认证失败",
		},
		{
			name:       "账号被禁用",
			authHeader: "Bearer valid-token",
			setupMock: func(m *MockAuthService) {
				m.On("Me", mock.Anything, "Bearer valid-token").Return(nil, service.ErrUserDisabled).Once()
			},
			expectedStatus: http.StatusForbidden,
			expectedMsg:    "账号已被禁用",
		},
	}

	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			mockSvc := new(MockAuthService)
			tt.setupMock(mockSvc)

			router := gin.New()
			RegisterAuthRoutes(router, mockSvc)

			req := httptest.NewRequest(http.MethodGet, "/auth/me", nil)
			if tt.authHeader != "" {
				req.Header.Set("Authorization", tt.authHeader)
			}
			w := httptest.NewRecorder()

			router.ServeHTTP(w, req)

			assert.Equal(t, tt.expectedStatus, w.Code)
			
			var response map[string]interface{}
			err := json.Unmarshal(w.Body.Bytes(), &response)
			require.NoError(t, err)
			
			assert.Contains(t, response["message"].(string), tt.expectedMsg)

			mockSvc.AssertExpectations(t)
		})
	}
}

func TestRefreshHandler(t *testing.T) {
	gin.SetMode(gin.TestMode)

	tests := []struct {
		name           string
		authHeader     string
		setupMock      func(*MockAuthService)
		expectedStatus int
		expectedMsg    string
	}{
		{
			name:       "刷新Token成功",
			authHeader: "Bearer valid-token",
			setupMock: func(m *MockAuthService) {
				m.On("RefreshToken", mock.Anything, "valid-token").Return("new-token", nil).Once()
			},
			expectedStatus: http.StatusOK,
			expectedMsg:    "success",
		},
		{
			name:           "缺少Authorization头",
			authHeader:     "",
			setupMock:      func(m *MockAuthService) {},
			expectedStatus: http.StatusUnauthorized,
			expectedMsg:    "无效的Token格式",
		},
		{
			name:       "无效的Token格式",
			authHeader: "Bearer invalid-token-format",
			setupMock: func(m *MockAuthService) {
				m.On("RefreshToken", mock.Anything, "invalid-token-format").Return("", errors.New("invalid token")).Once()
			},
			expectedStatus: http.StatusUnauthorized,
			expectedMsg:    "刷新Token失败",
		},
		{
			name:       "账号被禁用",
			authHeader: "Bearer valid-token",
			setupMock: func(m *MockAuthService) {
				m.On("RefreshToken", mock.Anything, "valid-token").Return("", service.ErrUserDisabled).Once()
			},
			expectedStatus: http.StatusForbidden,
			expectedMsg:    "账号已被禁用",
		},
	}

	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			mockSvc := new(MockAuthService)
			tt.setupMock(mockSvc)

			router := gin.New()
			RegisterAuthRoutes(router, mockSvc)

			req := httptest.NewRequest(http.MethodPost, "/auth/refresh", nil)
			if tt.authHeader != "" {
				req.Header.Set("Authorization", tt.authHeader)
			}
			w := httptest.NewRecorder()

			router.ServeHTTP(w, req)

			assert.Equal(t, tt.expectedStatus, w.Code)
			
			var response map[string]interface{}
			err := json.Unmarshal(w.Body.Bytes(), &response)
			require.NoError(t, err)
			
			assert.Contains(t, response["message"].(string), tt.expectedMsg)

			mockSvc.AssertExpectations(t)
		})
	}
}

func TestLogoutHandler(t *testing.T) {
	gin.SetMode(gin.TestMode)

	router := gin.New()
	mockSvc := new(MockAuthService)
	RegisterAuthRoutes(router, mockSvc)

	req := httptest.NewRequest(http.MethodPost, "/auth/logout", nil)
	w := httptest.NewRecorder()

	router.ServeHTTP(w, req)

	assert.Equal(t, http.StatusOK, w.Code)
	
	var response map[string]interface{}
	err := json.Unmarshal(w.Body.Bytes(), &response)
	require.NoError(t, err)
	
	assert.Equal(t, "success", response["message"])
	
	data := response["extensions"].(map[string]interface{})["data"].(map[string]interface{})
	assert.Equal(t, "logged out", data["message"])
}


