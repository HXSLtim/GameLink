// setupPaymentBenchmarkSuite creates a benchmark suite for payment operations
func setupPaymentBenchmarkSuite(b *testing.B) (*framework.BenchmarkSuite, *Service) {
	config := framework.DefaultConfig()
	suite := framework.NewBenchmarkSuite(b, config)

	// Create payment repository
	paymentRepo := payment.NewPaymentRepository(suite.DB)

	// Create payment service
	paymentService := NewService(paymentRepo, cache.NewInMemoryCache())

	return suite, paymentService
}

// BenchmarkCreatePayment benchmarks payment creation
func BenchmarkCreatePayment(b *testing.B) {
	suite, paymentService := setupPaymentBenchmarkSuite(b)
	ctx := context.Background()

	// Setup test data
	testUser := suite.CreateBenchmarkUser(b, "bench_user_payment")
	testOrder := &model.Order{
		Base:         model.Base{ID: 1001},
		UserID:       testUser.ID,
		TotalPriceCents: 5000, // 50 CNY
		Status:       model.OrderStatusPending,
	}
	if err := suite.DB.Create(testOrder).Error; err != nil {
		b.Fatalf("Failed to create test order: %v", err)
	}

	b.ResetTimer()
	b.ReportAllocs()

	for i := 0; i < b.N; i++ {
		pay := &model.Payment{
			OrderID:      testOrder.ID,
			UserID:       testUser.ID,
			AmountCents:  testOrder.TotalPriceCents,
			Method:       model.PaymentMethodAlipay,
			Status:       model.PaymentStatusPending,
			TransactionNo: fmt.Sprintf("BENCH_%d_%d", time.Now().Unix(), i),
		}

		_, err := paymentService.CreatePayment(ctx, pay)
		if err != nil {
			b.Fatalf("Failed to create payment: %v", err)
		}
	}

	// Cleanup
	suite.CleanBenchmarkData(b)
	suite.ResetBenchmarkSequence(b)
}

// BenchmarkPaymentStatusUpdate benchmarks payment status updates
func BenchmarkPaymentStatusUpdate(b *testing.B) {
	suite, paymentService := setupPaymentBenchmarkSuite(b)
	ctx := context.Background()

	// Setup test data
	testUser := suite.CreateBenchmarkUser(b, "bench_user_status")

	// Create multiple payments to update
	payments := make([]*model.Payment, 100)
	for i := 0; i < 100; i++ {
		testOrder := &model.Order{
			Base:           model.Base{ID: uint64(2000 + i)},
			UserID:         testUser.ID,
			TotalPriceCents: 5000,
			Status:         model.OrderStatusPending,
		}
		if err := suite.DB.Create(testOrder).Error; err != nil {
			b.Fatalf("Failed to create test order: %v", err)
		}

		pay := &model.Payment{
			OrderID:       testOrder.ID,
			UserID:        testUser.ID,
			AmountCents:   testOrder.TotalPriceCents,
			Method:        model.PaymentMethodAlipay,
			Status:        model.PaymentStatusPending,
			TransactionNo: fmt.Sprintf("STATUS_BENCH_%d", i),
		}
		if err := suite.DB.Create(pay).Error; err != nil {
			b.Fatalf("Failed to create payment: %v", err)
		}
		payments[i] = pay
	}

	b.ResetTimer()
	b.ReportAllocs()

	idx := 0
	for i := 0; i < b.N; i++ {
		paymentID := payments[idx%100].ID
		err := paymentService.UpdatePaymentStatus(ctx, paymentID, model.PaymentStatusSuccess)
		if err != nil {
			b.Fatalf("Failed to update payment status: %v", err)
		}
		// Reset for next iteration
		_ = paymentService.UpdatePaymentStatus(ctx, paymentID, model.PaymentStatusPending)
		idx++
	}

	// Cleanup
	suite.CleanBenchmarkData(b)
	suite.ResetBenchmarkSequence(b)
}

