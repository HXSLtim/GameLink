	for i := 0; i < 10; i++ {
		pay := &model.Payment{
			OrderID:       testOrder.ID,
			UserID:        testUser.ID,
			AmountCents:   500 + int64(i*100),
			Method:        model.PaymentMethodAlipay,
			Status:        model.PaymentStatusPending,
			TransactionNo: fmt.Sprintf("ORDER_BENCH_%d", i),
		}
