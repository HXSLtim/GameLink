// BenchmarkPasswordValidation benchmarks password validation
func BenchmarkPasswordValidation(b *testing.B) {
	suite, _ := setupAuthBenchmarkSuite(b)

	passwords := []string{
		"Pass123!@#",
		"password123",
		"PASSWORD123",
		"Pass123456789",
		"P@ssw0rd",
		"Test123!@#",
	}

	b.ResetTimer()
	b.ReportAllocs()

	for i := 0; i < b.N; i++ {
		password := passwords[i%len(passwords)]
		_ = validatePasswordRequirements(password)
	}
}

// BenchmarkConcurrentLogin benchmarks concurrent login attempts
func BenchmarkConcurrentLogin(b *testing.B) {
	suite, authService := setupAuthBenchmarkSuite(b)
	ctx := context.Background()

	// Setup test user
	testUser := &model.User{
		Phone:     "13800138003",
		Email:     "concurrent@gamelink.com",
		Name:      "Concurrent User",
		Role:      model.RoleUser,
		Status:    model.UserStatusActive,
		PasswordHash: "$2a$10$N9qo8uLOickgx2ZMRZoMyeIjZAgcfl7p92ldGxad68LJZdL17lhWy",
	}
	if err := suite.DB.Create(testUser).Error; err != nil {
		b.Fatalf("Failed to create test user: %v", err)
	}

	b.ResetTimer()

	b.RunParallel(func(pb *testing.PB) {
		for pb.Next() {
			req := LoginRequest{
				Username: "13800138003",
				Password: "password123",
			}

			_, err := authService.Login(ctx, req)
			if err != nil {
				b.Errorf("Concurrent login failed: %v", err)
			}
		}
	})

	// Cleanup
	suite.CleanBenchmarkData(b)
	suite.ResetBenchmarkSequence(b)
}

