// BenchmarkPhoneNormalization benchmarks phone number normalization
func BenchmarkPhoneNormalization(b *testing.B) {
	phones := []string{
		"13800138000",
		"+8613800138000",
		" 13800138000 ",
		"138-0013-8000",
	}

	b.ResetTimer()
	b.ReportAllocs()

	for i := 0; i < b.N; i++ {
		phone := phones[i%len(phones)]
		_ = normalizePhone(phone)
	}
}

// BenchmarkEmailValidation benchmarks email validation
func BenchmarkEmailValidation(b *testing.B) {
	emails := []string{
		"user@gamelink.com",
		"test.user@example.com",
		"invalid-email",
		"invalid@",
		"@example.com",
	}

	b.ResetTimer()
	b.ReportAllocs()

	for i := 0; i < b.N; i++ {
		email := emails[i%len(emails)]
		_ = isValidEmail(email)
	}
}

// BenchmarkMultipleAuthOperations benchmarks mixed authentication operations
func BenchmarkMultipleAuthOperations(b *testing.B) {
	suite, authService := setupAuthBenchmarkSuite(b)
	ctx := context.Background()

	// Setup test users
	users := make([]*model.User, 10)
	for i := 0; i < 10; i++ {
		users[i] = suite.CreateBenchmarkUser(b, fmt.Sprintf("1380013%04d", i))
	}

	b.ResetTimer()
	b.ReportAllocs()

	for i := 0; i < b.N; i++ {
		userIdx := i % 10

		// 1. Login
		req := LoginRequest{
			Username: users[userIdx].Phone,
			Password: "password123",
		}
		resp, err := authService.Login(ctx, req)
		if err != nil {
			b.Fatalf("Login failed: %v", err)
		}

		// 2. Verify token
		_, err = authService.jwtManager.VerifyToken(resp.Token)
		if err != nil {
			b.Fatalf("Token verification failed: %v", err)
		}

		// 3. Get user
		_, err = authService.GetUser(ctx, users[userIdx].ID)
		if err != nil {
			b.Fatalf("Get user failed: %v", err)
		}
	}

	// Cleanup
	suite.CleanBenchmarkData(b)
	suite.ResetBenchmarkSequence(b)
}

// Helper functions

// generateToken is a helper to generate JWT tokens (extracted for benchmarking)
func (s *AuthService) generateToken(userID uint64, role model.Role) (string, error) {
	return s.jwtManager.GenerateToken(userID, role, "")
}

// validatePasswordRequirements validates password requirements
func validatePasswordRequirements(password string) bool {
	if len(password) < 8 {
		return false
	}

	hasUpper := false
	hasLower := false
	hasNumber := false

	for _, char := range password {
		switch {
		case char >= 'A' && char <= 'Z':
			hasUpper = true
		case char >= 'a' && char <= 'z':
			hasLower = true
		case char >= '0' && char <= '9':
			hasNumber = true
		}
	}

	return hasUpper && hasLower && hasNumber
}

// normalizePhone normalizes phone number format
func normalizePhone(phone string) string {
	// Remove spaces and dashes
	for _, r := range " -" {
		phone = removeAll(phone, r)
	}
	// Remove +86 prefix if present
	if len(phone) == 13 && phone[:3] == "+86" {
		phone = phone[3:]
	}
	return phone
}

// isValidEmail validates email format
func isValidEmail(email string) bool {
	return len(email) > 0 && contains(email, "@") && contains(email, ".")
}

// removeAll removes all occurrences of a rune from string
func removeAll(s string, r rune) string {
	result := make([]rune, 0, len(s))
	for _, c := range s {
		if c != r {
			result = append(result, c)
		}
	}
	return string(result)
}

// contains checks if string contains substring
func contains(s, substr string) bool {
	return len(s) >= len(substr) && indexOf(s, substr) >= 0
}

// indexOf finds index of substring
func indexOf(s, substr string) int {
	for i := 0; i <= len(s)-len(substr); i++ {
		if s[i:i+len(substr)] == substr {
			return i
		}
	}
	return -1
}
