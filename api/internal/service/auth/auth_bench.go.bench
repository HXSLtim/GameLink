package auth

import (
	"context"
	"fmt"
	"testing"
	"time"

	"gamelink/benchmark/framework"
	"gamelink/internal/model"
	"gamelink/internal/repository/user"
	"gamelink/pkg/auth"
)

// setupAuthBenchmarkSuite creates a benchmark suite for auth operations
func setupAuthBenchmarkSuite(b *testing.B) (*framework.BenchmarkSuite, *AuthService) {
	config := framework.DefaultConfig()
	suite := framework.NewBenchmarkSuite(b, config)

	// Create JWT manager for benchmarks
	jwtManager := auth.NewJWTManager("benchmark-secret-key-for-performance-testing-32chars", 24*time.Hour, 7*24*time.Hour)

	// Create user repository
	userRepo := user.NewUserRepository(suite.DB)

	// Create auth service
	authService := NewAuthService(userRepo, jwtManager)

	suite.AuthService = authService

	return suite, authService
}

// BenchmarkLogin benchmarks the login operation
func BenchmarkLogin(b *testing.B) {
	suite, authService := setupAuthBenchmarkSuite(b)
	ctx := context.Background()

	// Setup test user with known credentials
	testUser := &model.User{
		Phone:     "13800138000",
		Email:     "benchmark@gamelink.com",
		Name:      "Benchmark User",
		Role:      model.RoleUser,
		Status:    model.UserStatusActive,
		PasswordHash: "$2a$10$N9qo8uLOickgx2ZMRZoMyeIjZAgcfl7p92ldGxad68LJZdL17lhWy", // "password123"
	}
	if err := suite.DB.Create(testUser).Error; err != nil {
		b.Fatalf("Failed to create test user: %v", err)
	}

	b.ResetTimer()
	b.ReportAllocs()

	for i := 0; i < b.N; i++ {
		req := LoginRequest{
			Username: "13800138000",
			Password: "password123",
		}

		_, err := authService.Login(ctx, req)
		if err != nil {
			b.Fatalf("Login failed: %v", err)
		}
	}

	// Cleanup
	suite.CleanBenchmarkData(b)
	suite.ResetBenchmarkSequence(b)
}

// BenchmarkTokenGeneration benchmarks JWT token generation
func BenchmarkTokenGeneration(b *testing.B) {
	suite, authService := setupAuthBenchmarkSuite(b)

	b.ResetTimer()
	b.ReportAllocs()

	for i := 0; i < b.N; i++ {
		userID := uint64(1000 + i)
		role := model.RoleUser

		_, err := authService.generateToken(userID, role)
		if err != nil {
			b.Fatalf("Token generation failed: %v", err)
		}
	}
}

// BenchmarkTokenVerification benchmarks JWT token verification
func BenchmarkTokenVerification(b *testing.B) {
	suite, authService := setupAuthBenchmarkSuite(b)
	ctx := context.Background()

	// Generate a test token
	testUser := suite.CreateBenchmarkUser(b, "13800138001")
	token, err := authService.generateToken(testUser.ID, testUser.Role)
	if err != nil {
		b.Fatalf("Failed to generate test token: %v", err)
	}

	b.ResetTimer()
	b.ReportAllocs()

	for i := 0; i < b.N; i++ {
		_, err := authService.jwtManager.VerifyToken(token)
		if err != nil {
			b.Fatalf("Token verification failed: %v", err)
		}
	}
}

// BenchmarkMe benchmarks the /auth/me endpoint (token verification + user retrieval)
func BenchmarkMe(b *testing.B) {
	suite, authService := setupAuthBenchmarkSuite(b)
	ctx := context.Background()

	// Setup test user and generate token
	testUser := suite.CreateBenchmarkUser(b, "13800138002")
	token, err := authService.generateToken(testUser.ID, testUser.Role)
	if err != nil {
		b.Fatalf("Failed to generate test token: %v", err)
	}

	authHeader := fmt.Sprintf("Bearer %s", token)

	b.ResetTimer()
	b.ReportAllocs()

	for i := 0; i < b.N; i++ {
		_, err := authService.Me(ctx, authHeader)
		if err != nil {
			b.Fatalf("Me endpoint failed: %v", err)
		}
	}

	// Cleanup
	suite.CleanBenchmarkData(b)
	suite.ResetBenchmarkSequence(b)
}

