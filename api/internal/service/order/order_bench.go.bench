	scheduledStart := time.Now().Add(1 * time.Hour)
	req := CreateOrderRequest{
		PlayerID:       testPlayer.ID,
		GameID:         testGame.ID,
		Title:          "Get Test Order",
		ScheduledStart: &scheduledStart,
		DurationHours:  1.0,
	}
