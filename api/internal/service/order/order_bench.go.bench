package order

import (
	"context"
	"fmt"
	"testing"
	"time"

	"gamelink/benchmark/framework"
	"gamelink/internal/model"
	"gamelink/internal/repository"
	"gamelink/internal/repository/commission"
	"gamelink/internal/repository/game"
	"gamelink/internal/repository/order"
	"gamelink/internal/repository/payment"
	"gamelink/internal/repository/player"
	"gamelink/internal/repository/review"
	"gamelink/internal/repository/user"
	"gamelink/pkg/cache"
)

// setupOrderBenchmarkSuite creates a benchmark suite for order operations
func setupOrderBenchmarkSuite(b *testing.B) (*framework.BenchmarkSuite, *OrderService) {
	config := framework.DefaultConfig()
	suite := framework.NewBenchmarkSuite(b, config)

	// Create additional repositories needed for order service
	playerRepo := player.NewPlayerRepository(suite.DB)
	gameRepo := game.NewGameRepository(suite.DB)
	paymentRepo := payment.NewPaymentRepository(suite.DB)
	reviewRepo := review.NewReviewRepository(suite.DB)
	commissionRepo := commission.NewCommissionRepository(suite.DB)

	// Create order repository
	orderRepo := order.NewOrderRepository(suite.DB)

	// Create order service
	orderService := NewOrderService(
		orderRepo,
		playerRepo,
		suite.UserRepo,
		gameRepo,
		paymentRepo,
		reviewRepo,
		commissionRepo,
	)

	// Inject cache (in-memory for benchmarks)
	orderService.SetCache(cache.NewInMemoryCache())

	suite.OrderService = orderService
	suite.PlayerRepo = playerRepo
	suite.GameRepo = gameRepo

	return suite, orderService
}

// BenchmarkOrderCreation_Simple benchmarks basic order creation
func BenchmarkOrderCreation_Simple(b *testing.B) {
	suite, orderService := setupOrderBenchmarkSuite(b)
	ctx := context.Background()

	// Setup test data
	testUser := suite.CreateBenchmarkUser(b, "bench_user_simple")
	testPlayer := suite.CreateBenchmarkPlayer(b, testUser.ID, "bench_player_simple")
	testGame := suite.CreateBenchmarkGame(b, "Benchmark Game")

	scheduledStart := time.Now().Add(1 * time.Hour)

	b.ResetTimer()
	b.ReportAllocs()

	for i := 0; i < b.N; i++ {
		req := CreateOrderRequest{
			PlayerID:       testPlayer.ID,
			GameID:         testGame.ID,
			Title:          fmt.Sprintf("Benchmark Order %d", i),
			Description:    "Performance test order",
			ScheduledStart: &scheduledStart,
			DurationHours:  1.0,
		}

		_, err := orderService.CreateOrder(ctx, testUser.ID, req)
		if err != nil {
			b.Fatalf("Failed to create order: %v", err)
		}
	}

	// Cleanup
	suite.CleanBenchmarkData(b)
	suite.ResetBenchmarkSequence(b)
}

// BenchmarkOrderListing benchmarks order listing with pagination
func BenchmarkOrderListing(b *testing.B) {
	suite, orderService := setupOrderBenchmarkSuite(b)
	ctx := context.Background()

	// Setup test data
	testUser := suite.CreateBenchmarkUser(b, "bench_user_list")
	testPlayer := suite.CreateBenchmarkPlayer(b, testUser.ID, "bench_player_list")
	testGame := suite.CreateBenchmarkGame(b, "List Benchmark Game")

	// Create 1000 orders for listing tests
	scheduledStart := time.Now().Add(1 * time.Hour)
	for i := 0; i < 1000; i++ {
		req := CreateOrderRequest{
			PlayerID:       testPlayer.ID,
			GameID:         testGame.ID,
			Title:          fmt.Sprintf("List Test Order %d", i),
			ScheduledStart: &scheduledStart,
			DurationHours:  1.0,
		}
		_, _ = orderService.CreateOrder(ctx, testUser.ID, req)
	}

	b.ResetTimer()
	b.ReportAllocs()

	for i := 0; i < b.N; i++ {
		_, err := orderService.GetUserOrders(ctx, testUser.ID, 1, 20, nil, nil)
		if err != nil {
			b.Fatalf("Failed to list orders: %v", err)
		}
	}

	// Cleanup
	suite.CleanBenchmarkData(b)
	suite.ResetBenchmarkSequence(b)
}

// BenchmarkOrderGetByID benchmarks retrieving a single order by ID
