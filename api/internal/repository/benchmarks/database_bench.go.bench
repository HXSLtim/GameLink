		}
	}

	// Cleanup
	suite.CleanBenchmarkData(b)
	suite.ResetBenchmarkSequence(b)
}

// BenchmarkDBJoin_Simple benchmarks simple join operations
func BenchmarkDBJoin_Simple(b *testing.B) {
	config := framework.DefaultConfig()
	suite := framework.NewBenchmarkSuite(b, config)

	// Setup test data
	users := make([]*model.User, 100)
	players := make([]*model.Player, 100)
	for i := 0; i < 100; i++ {
		users[i] = suite.CreateBenchmarkUser(b, fmt.Sprintf("1380019%04d", i))
		players[i] = suite.CreateBenchmarkPlayer(b, users[i].ID, fmt.Sprintf("Player %d", i))
	}

	ctx := context.Background()
	b.ResetTimer()
	b.ReportAllocs()

	for i := 0; i < b.N; i++ {
		type result struct {
			model.User
			PlayerNickname string
		}
		var results []result

		userID := users[i%100].ID
		if err := suite.DB.WithContext(ctx).
			Table("users").
			Select("users.*, players.nickname as player_nickname").
			Joins("LEFT JOIN players ON players.user_id = users.id").
			Where("users.id = ?", userID).
			Find(&results).Error; err != nil {
			b.Fatalf("Failed to execute join query: %v", err)
		}
	}

	// Cleanup
	suite.CleanBenchmarkData(b)
	suite.ResetBenchmarkSequence(b)
}

// BenchmarkDBJoin_Complex benchmarks complex join operations with multiple tables
func BenchmarkDBJoin_Complex(b *testing.B) {
	config := framework.DefaultConfig()
	suite := framework.NewBenchmarkSuite(b, config)

	// Setup test data
	users := make([]*model.User, 50)
	players := make([]*model.Player, 50)
	games := make([]*model.Game, 10)
	for i := 0; i < 10; i++ {
		games[i] = suite.CreateBenchmarkGame(b, fmt.Sprintf("Game %d", i))
	}
	for i := 0; i < 50; i++ {
		users[i] = suite.CreateBenchmarkUser(b, fmt.Sprintf("1380020%02d", i))
		players[i] = suite.CreateBenchmarkPlayer(b, users[i].ID, fmt.Sprintf("Player %d", i))

		// Create orders
		for j := 0; j < 10; j++ {
			order := &model.Order{
				OrderNo:         fmt.Sprintf("ORDER_%d_%d", i, j),
				UserID:          users[i].ID,
				PlayerID:        &players[i].ID,
				GameID:          &games[j%10].ID,
				TotalPriceCents: 5000,
				Status:          model.OrderStatusCompleted,
			}
			if err := suite.DB.Create(order).Error; err != nil {
				b.Fatalf("Failed to create order: %v", err)
			}
		}
	}

	ctx := context.Background()
	b.ResetTimer()
	b.ReportAllocs()

	for i := 0; i < b.N; i++ {
		type result struct {
			OrderNo        string
			UserName       string
			PlayerNickname string
			GameName       string
			TotalPriceCents int64
		}
		var results []result

		if err := suite.DB.WithContext(ctx).
			Table("orders").
			Select("orders.order_no, users.name as user_name, players.nickname as player_nickname, games.name as game_name, orders.total_price_cents").
			Joins("LEFT JOIN users ON users.id = orders.user_id").
			Joins("LEFT JOIN players ON players.id = orders.player_id").
			Joins("LEFT JOIN games ON games.id = orders.game_id").
			Where("orders.user_id = ?", users[i%50].ID).
			Find(&results).Error; err != nil {
			b.Fatalf("Failed to execute complex join: %v", err)
		}
	}

	// Cleanup
	suite.CleanBenchmarkData(b)
	suite.ResetBenchmarkSequence(b)
}

