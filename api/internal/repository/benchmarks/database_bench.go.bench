		}
	}

	// Cleanup
	suite.CleanBenchmarkData(b)
	suite.ResetBenchmarkSequence(b)
}

// BenchmarkDBSelect_Pagination benchmarks paginated queries
func BenchmarkDBSelect_Pagination(b *testing.B) {
	config := framework.DefaultConfig()
	suite := framework.NewBenchmarkSuite(b, config)

	// Setup test data
	for i := 0; i < 1000; i++ {
		suite.CreateBenchmarkUser(b, fmt.Sprintf("1380016%04d", i))
	}

	ctx := context.Background()
	b.ResetTimer()
	b.ReportAllocs()

	for i := 0; i < b.N; i++ {
		var users []model.User
		if err := suite.DB.WithContext(ctx).Offset((i % 50) * 20).Limit(20).Find(&users).Error; err != nil {
			b.Fatalf("Failed to select paginated users: %v", err)
		}
	}

	// Cleanup
	suite.CleanBenchmarkData(b)
	suite.ResetBenchmarkSequence(b)
}

