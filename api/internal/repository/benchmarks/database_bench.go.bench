package benchmarks

import (
	"context"
	"fmt"
	"testing"
	"time"

	"gamelink/benchmark/framework"
	"gamelink/internal/model"
)

// BenchmarkDBInsert_Single benchmarks single database insert operations
func BenchmarkDBInsert_Single(b *testing.B) {
	config := framework.DefaultConfig()
	suite := framework.NewBenchmarkSuite(b, config)

	b.ResetTimer()
	b.ReportAllocs()

	for i := 0; i < b.N; i++ {
		user := &model.User{
			Phone:     fmt.Sprintf("1380013%04d", i),
			Email:     fmt.Sprintf("user%d@gamelink.com", i),
			Name:      fmt.Sprintf("User %d", i),
			Role:      model.RoleUser,
			Status:    model.UserStatusActive,
			PasswordHash: "$2a$10$hash",
		}
		if err := suite.DB.Create(user).Error; err != nil {
			b.Fatalf("Failed to insert user: %v", err)
		}
	}

	// Cleanup
	suite.CleanBenchmarkData(b)
	suite.ResetBenchmarkSequence(b)
}

// BenchmarkDBInsert_Batch benchmarks batch database insert operations
func BenchmarkDBInsert_Batch(b *testing.B) {
	config := framework.DefaultConfig()
	suite := framework.NewBenchmarkSuite(b, config)

	batchSize := 100
	b.ResetTimer()
	b.ReportAllocs()

	for i := 0; i < b.N; i++ {
		users := make([]*model.User, batchSize)
		for j := 0; j < batchSize; j++ {
			users[j] = &model.User{
				Phone:     fmt.Sprintf("1390013%04d", i*batchSize+j),
				Email:     fmt.Sprintf("batchuser%d@gamelink.com", i*batchSize+j),
				Name:      fmt.Sprintf("Batch User %d", i*batchSize+j),
				Role:      model.RoleUser,
				Status:    model.UserStatusActive,
				PasswordHash: "$2a$10$hash",
			}
		}

		if err := suite.DB.CreateInBatches(users, batchSize).Error; err != nil {
			b.Fatalf("Failed to batch insert users: %v", err)
		}
	}

	// Cleanup
	suite.CleanBenchmarkData(b)
	suite.ResetBenchmarkSequence(b)
}

// BenchmarkDBSelectByPrimaryKey benchmarks primary key lookups
func BenchmarkDBSelectByPrimaryKey(b *testing.B) {
	config := framework.DefaultConfig()
	suite := framework.NewBenchmarkSuite(b, config)

	// Setup test data
	users := make([]*model.User, 1000)
	for i := 0; i < 1000; i++ {
		users[i] = suite.CreateBenchmarkUser(b, fmt.Sprintf("1380014%04d", i))
	}

	ctx := context.Background()
	b.ResetTimer()
	b.ReportAllocs()

	for i := 0; i < b.N; i++ {
		userID := users[i%1000].ID
		var user model.User
		if err := suite.DB.WithContext(ctx).First(&user, userID).Error; err != nil {
			b.Fatalf("Failed to select user: %v", err)
		}
	}

	// Cleanup
	suite.CleanBenchmarkData(b)
	suite.ResetBenchmarkSequence(b)
}

// BenchmarkDBSelectByIndex benchmarks indexed column lookups
func BenchmarkDBSelectByIndex(b *testing.B) {
	config := framework.DefaultConfig()
