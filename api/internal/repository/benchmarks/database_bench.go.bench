// BenchmarkDBTransaction benchmarks transaction operations
func BenchmarkDBTransaction(b *testing.B) {
	config := framework.DefaultConfig()
	suite := framework.NewBenchmarkSuite(b, config)

	ctx := context.Background()
	b.ResetTimer()
	b.ReportAllocs()

	for i := 0; i < b.N; i++ {
		err := suite.DB.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
			user := &model.User{
				Phone:     fmt.Sprintf("1380022%04d", i),
				Email:     fmt.Sprintf("txuser%d@gamelink.com", i),
				Name:      fmt.Sprintf("TX User %d", i),
				Role:      model.RoleUser,
				Status:    model.UserStatusActive,
				PasswordHash: "$2a$10$hash",
			}
			if err := tx.Create(user).Error; err != nil {
				return err
			}

			player := &model.Player{
				UserID:   user.ID,
				Nickname: fmt.Sprintf("TX Player %d", i),
				Status:   model.PlayerStatusActive,
			}
			if err := tx.Create(player).Error; err != nil {
				return err
			}

			return nil
		})

		if err != nil {
			b.Fatalf("Transaction failed: %v", err)
		}
	}

	// Cleanup
	suite.CleanBenchmarkData(b)
	suite.ResetBenchmarkSequence(b)
}

// BenchmarkDBConcurrentInserts benchmarks concurrent insert operations
func BenchmarkDBConcurrentInserts(b *testing.B) {
	config := framework.DefaultConfig()
	suite := framework.NewBenchmarkSuite(b, config)

	b.ResetTimer()

	b.RunParallel(func(pb *testing.PB) {
		i := 0
		for pb.Next() {
			user := &model.User{
				Phone:     fmt.Sprintf("1380023%04d", i),
				Email:     fmt.Sprintf("concurrent%d@gamelink.com", i),
				Name:      fmt.Sprintf("Concurrent User %d", i),
				Role:      model.RoleUser,
				Status:    model.UserStatusActive,
				PasswordHash: "$2a$10$hash",
			}
			if err := suite.DB.Create(user).Error; err != nil {
				b.Errorf("Failed to insert user: %v", err)
			}
			i++
		}
	})

	// Cleanup
	suite.CleanBenchmarkData(b)
	suite.ResetBenchmarkSequence(b)
}

// BenchmarkDBSubQuery benchmarks subquery operations
func BenchmarkDBSubQuery(b *testing.B) {
	config := framework.DefaultConfig()
	suite := framework.NewBenchmarkSuite(b, config)

	// Setup test data
	users := make([]*model.User, 100)
	for i := 0; i < 100; i++ {
		users[i] = suite.CreateBenchmarkUser(b, fmt.Sprintf("1380024%04d", i))
		suite.CreateBenchmarkPlayer(b, users[i].ID, fmt.Sprintf("Player %d", i))
	}

	ctx := context.Background()
	b.ResetTimer()
	b.ReportAllocs()

	for i := 0; i < b.N; i++ {
		var users []model.User
		// Find users who are players
		if err := suite.DB.WithContext(ctx).
			Where("id IN (SELECT user_id FROM players)").
			Find(&users).Error; err != nil {
			b.Fatalf("Failed to execute subquery: %v", err)
		}
	}

	// Cleanup
	suite.CleanBenchmarkData(b)
	suite.ResetBenchmarkSequence(b)
}

// BenchmarkDBAggregate benchmarks aggregate functions
func BenchmarkDBAggregate(b *testing.B) {
	config := framework.DefaultConfig()
	suite := framework.NewBenchmarkSuite(b, config)

	// Setup test data with varying amounts
	for i := 0; i < 1000; i++ {
		user := suite.CreateBenchmarkUser(b, fmt.Sprintf("1380025%04d", i))

		// Create orders with different prices
		for j := 0; j < 5; j++ {
			order := &model.Order{
				OrderNo:         fmt.Sprintf("AGG_%d_%d", i, j),
				UserID:          user.ID,
				TotalPriceCents: int64((j + 1) * 1000),
				Status:          model.OrderStatusCompleted,
			}
			if err := suite.DB.Create(order).Error; err != nil {
				b.Fatalf("Failed to create order: %v", err)
			}
		}
	}

	ctx := context.Background()
	b.ResetTimer()
	b.ReportAllocs()

	for i := 0; i < b.N; i++ {
		type aggregateResult struct {
			TotalAmount int64
			AvgAmount   float64
			MaxAmount   int64
			MinAmount   int64
			Count       int64
		}

		var result aggregateResult
		if err := suite.DB.WithContext(ctx).
			Model(&model.Order{}).
			Select("COALESCE(SUM(total_price_cents), 0) as total_amount, COALESCE(AVG(total_price_cents), 0) as avg_amount, COALESCE(MAX(total_price_cents), 0) as max_amount, COALESCE(MIN(total_price_cents), 0) as min_amount, COUNT(*) as count").
			Where("status = ?", model.OrderStatusCompleted).
			Scan(&result).Error; err != nil {
			b.Fatalf("Failed to execute aggregate query: %v", err)
		}
	}

	// Cleanup
	suite.CleanBenchmarkData(b)
	suite.ResetBenchmarkSequence(b)
}
