{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "overrides": {
    "xlsx": "0.18.5"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:analyze": "tsc -b && vite build --mode analyze",
