# GameLink Admin Panel - Environment Variables Template
# Copy this file to .env and fill in the actual values
# IMPORTANT: Never commit .env file to version control

# =============================================================================
# API Configuration
# =============================================================================
# Backend API base URL (dev recommended: /api/v1 via Vite proxy)
VITE_API_BASE_URL=/api/v1

# =============================================================================
# Security: Encryption Configuration
# =============================================================================
# IMPORTANT: Backend encryption must match frontend configuration
# If backend has CRYPTO_ENABLED=true, frontend must also have encryption enabled

# Enable client-side encryption (must match backend CRYPTO_ENABLED)
VITE_CRYPTO_ENABLED=false

# AES-256-CBC Encryption Keys (REQUIRED when VITE_CRYPTO_ENABLED=true)
# These MUST match the backend CRYPTO_SECRET_KEY and CRYPTO_IV exactly
# Secret Key must be exactly 32 bytes (raw bytes, not base64 encoded for frontend)
# Generate with: openssl rand -base64 32 | base64 -d | xxd -p -c 32
VITE_CRYPTO_SECRET_KEY=

# Initialization Vector must be exactly 16 bytes (raw bytes, not base64 encoded for frontend)
# Generate with: openssl rand -base64 16 | base64 -d | xxd -p -c 16
VITE_CRYPTO_IV=

# Use SHA-256 Signature (must match backend CRYPTO_USE_SIGNATURE)
# 开发环境：true（可选），生产环境：true（推荐）
# 注意：前后端签名配置必须保持一致
VITE_CRYPTO_USE_SIGNATURE=true

# =============================================================================
# Application Configuration
# =============================================================================
# Application title
VITE_APP_TITLE=GameLink Admin Panel

# Application version
VITE_APP_VERSION=1.0.0

# Enable debug mode (shows additional logs)
VITE_DEBUG=false

# =============================================================================
# Feature Flags
# =============================================================================
# Enable PWA service worker (default false to avoid cache hijack)
VITE_ENABLE_PWA=false

# Enable WebSocket for real-time updates
VITE_ENABLE_WEBSOCKET=true

# WebSocket reconnection attempts
VITE_WEBSOCKET_RECONNECT_ATTEMPTS=5

# WebSocket reconnection interval (milliseconds)
VITE_WEBSOCKET_RECONNECT_INTERVAL=3000

# WebSocket heartbeat interval (milliseconds, must match backend pingPeriod)
# Backend expects 54000ms (54 seconds) for ping interval
VITE_WEBSOCKET_HEARTBEAT_INTERVAL=54000

# =============================================================================
# Error Monitoring (Sentry)
# =============================================================================
# Enable Sentry error monitoring (recommended: true for production)
VITE_SENTRY_ENABLED=false

# Sentry DSN (Data Source Name) - Get from Sentry dashboard
# Example: https://examplePublicKey@o0.ingest.sentry.io/0
VITE_SENTRY_DSN=

# Sentry environment (e.g., production, staging, development)
VITE_SENTRY_ENVIRONMENT=production

# Error sample rate (0.0 to 1.0, recommended: 1.0 for production)
VITE_SENTRY_SAMPLE_RATE=1.0

# Performance monitoring sample rate (0.0 to 1.0, recommended: 0.1 for production)
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1

# =============================================================================
# UI Configuration
# =============================================================================
# Default pagination size
VITE_DEFAULT_PAGE_SIZE=20

# Maximum pagination size
VITE_MAX_PAGE_SIZE=100

# Date format (using moment.js format strings)
VITE_DATE_FORMAT=YYYY-MM-DD HH:mm:ss

# Timezone
VITE_TIMEZONE=Asia/Shanghai

# =============================================================================
# Security Notes
# =============================================================================
# 1. Never commit actual .env file to version control
# 2. Crypto keys in frontend are exposed in browser, so they should match backend
# 3. Only enable client-side encryption if backend also has it enabled
# 4. The frontend uses raw bytes for crypto keys, not base64 encoding
# 5. For development, you can disable encryption (VITE_CRYPTO_ENABLED=false)
# 6. For production, ensure backend and frontend crypto settings match
