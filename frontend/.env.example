# =============================================================================
# 环境变量配置模板 (.env.example)
# =============================================================================
# 复制此文件并重命名为 .env.development 或 .env.production
# 根据环境修改相应的值
#
# 变量命名规则：
# - 所有变量必须以 VITE_ 开头，才能在客户端代码中访问
# - 变量值不支持单引号或双引号包裹
# - # 开头的行为注释

# =============================================================================
# API 配置 (必需)
# =============================================================================

# 后端 API 基础地址
# 开发环境: http://localhost:8080
# 生产环境: https://api.gamelink.com
VITE_API_BASE_URL=http://localhost:8080

# =============================================================================
# Mock 配置（仅开发环境使用）
# =============================================================================

# 开发环境 Mock 登录用户名（vite.config.ts 使用）
VITE_DEV_MOCK_USERNAME=admin

# 开发环境 Mock 登录密码（vite.config.ts 使用）
VITE_DEV_MOCK_PASSWORD=admin123

# 开发环境 Mock Token（用于模拟登录态，vite.config.ts 使用）
VITE_DEV_MOCK_TOKEN=dev-token

# =============================================================================
# 加密配置（安全相关）
# =============================================================================

# 是否启用数据加密
# 开发环境: false (方便调试)
# 生产环境: true (建议开启)
VITE_CRYPTO_ENABLED=false

# AES 加密密钥（32字符）
# ⚠️ 生产环境必须修改！生成命令：
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
VITE_CRYPTO_SECRET_KEY=GameLink2025SecretKey!@#123456

# AES 初始化向量（16字符）
# ⚠️ 生产环境必须修改！生成命令：
# node -e "console.log(require('crypto').randomBytes(16).toString('base64'))"
VITE_CRYPTO_IV=GameLink2025IV!!!

# =============================================================================
# 功能开关
# =============================================================================

# 是否启用 Mock 数据（全局开关）
VITE_ENABLE_MOCK=false

# 是否启用 Bundle 分析器 (npm run build:analyze)
VITE_ENABLE_ANALYZER=false

# =============================================================================
# 演示功能配置
# =============================================================================

# 是否启用组件演示路由 (/showcase)
# 开发环境: true
# 生产环境: false
VITE_SHOWCASE_ENABLE_ROUTE=true

# 是否在演示页面中启用组件展示
VITE_SHOWCASE_ENABLE_COMPONENTS=true

# 是否展开演示示例代码
VITE_SHOWCASE_EXPAND_EXAMPLES=true

# 是否启用缓存演示路由 (/cache-demo)
VITE_CACHE_DEMO_ENABLE_ROUTE=true

# =============================================================================
# 第三方服务配置
# =============================================================================

# Sentry DSN（错误监控）
# VITE_SENTRY_DSN=

# Google Analytics ID
# VITE_GA_ID=

# =============================================================================
# 性能监控
# =============================================================================

# 是否启用性能监控
VITE_ENABLE_PERFORMANCE_MONITOR=false

# =============================================================================
# 日志配置
# =============================================================================

# 日志级别: debug | info | warn | error
VITE_LOG_LEVEL=info

# 是否启用日志上传（生产环境可开启）
VITE_ENABLE_LOG_UPLOAD=false

# =============================================================================
# 部署配置
# =============================================================================

# 部署环境: development | staging | production
VITE_DEPLOY_ENV=development

# 版本号
VITE_APP_VERSION=0.1.0

# 构建时间（npm run build 时自动注入）
# VITE_BUILD_TIME=
