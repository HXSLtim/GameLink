{
  "name": "gamelink-admin",
  "version": "0.1.0",
  "private": true,
  "description": "GameLink 是一个现代化的游戏陪玩管理平台，采用 Go 后端 + React 前端的架构，为游戏陪玩服务提供高效的订单分发、用户管理和陪玩师管理功能。核心功能 🎯 智能订单分发 - 自动匹配用户与陪玩师，支持抢单池和客服指派 👥 多角色管理 - 用户/陪玩师/管理员权限体系 💬 实时通讯 - WebSocket 即时通讯，支持群聊和私聊 💳 完整支付 - 订单支付、退款、收益结算一体化 📊 数据监控 - 实时订单状态、收益统计、系统指标 🔐 安全认证 - JWT + RBAC 权限控制",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/HXSLtim/GameLink.git"
  },
  "homepage": "https://github.com/HXSLtim/GameLink#readme",
  "bugs": {
    "url": "https://github.com/HXSLtim/GameLink/issues"
  },
  "author": "GameLink开发团队",
  "license": "MIT",
  "keywords": [
    "game-link",
    "gaming",
    "escort",
    "陪玩",
    "订单管理",
    "react",
    "typescript",
    "vite",
    "arco-design"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:analyze": "ANALYZE=true vite build",
    "preview": "vite preview",
    "lint": "eslint \"src/**/*.{ts,tsx,js,jsx}\" --max-warnings=0",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "axios": "^1.13.0",
    "crypto-js": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^20.11.30",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.11.0",
    "@typescript-eslint/parser": "^8.11.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.9",
    "c8": "^10.1.3",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "jsdom": "^25.0.1",
    "less": "^4.2.0",
    "prettier": "^3.3.3",
    "rollup-plugin-visualizer": "^6.0.5",
    "terser": "^5.44.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-full-reload": "^1.1.0",
    "vitest": "^2.1.3"
  }
}
