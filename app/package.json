{
  "name": "gamelink-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "validate:env": "node ../scripts/validate-frontend-env.mjs app",
    "predev": "npm run validate:env",
    "dev": "vite",
    "type-check": "tsc -b tsconfig.app.json tsconfig.node.json",
    "lint": "eslint .",
    "test": "vitest",
    "test:run": "vitest run",
    "prebuild": "npm run validate:env",
    "build": "tsc -b && vite build",
    "prepreview": "npm run validate:env",
    "preview": "vite preview",
    "validate:prd": "node ../scripts/validate-prd-docs.mjs",
    "validate:bizstory": "node ../scripts/validate-business-story-docs.mjs",
    "accept:engineer": "node ../scripts/engineering-acceptance.mjs"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.4",
    "axios": "^1.13.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.554.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.6",
    "tailwind-merge": "^3.3.1",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@rollup/rollup-linux-x64-gnu": "^4.59.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^28.1.0",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vitest": "^4.0.15"
  }
}
