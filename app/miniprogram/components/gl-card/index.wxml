<view
  class="gl-card {{shadow ? 'gl-card--shadow' : ''}} {{border ? 'gl-card--border' : ''}}"
  hover-class="{{hoverable ? 'gl-card--hover' : ''}}"
  hover-stay-time="100"
  bindtap="handleTap"
>
  <view wx:if="{{title}}" class="gl-card__header">
    <text class="gl-card__title">{{title}}</text>
    <slot name="extra"></slot>
  </view>
  <view class="gl-card__body">
    <slot></slot>
  </view>
</view>
