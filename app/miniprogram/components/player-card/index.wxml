<view class="player-card" bindtap="handleTap">
  <!-- 封面图 -->
  <view class="player-card__cover">
    <image 
      class="player-card__image" 
      src="{{player.imageUrl || player.avatar}}" 
      mode="aspectFill"
    />
    <!-- 在线状态 -->
    <view wx:if="{{player.isOnline}}" class="player-card__status"></view>
    <!-- 语音时长 -->
    <view wx:if="{{player.audioDuration}}" class="player-card__audio">
      <image class="player-card__audio-icon" src="/assets/icons/mic.svg" />
      <text>{{player.audioDuration}}"</text>
    </view>
  </view>
  
  <!-- 信息区 -->
  <view class="player-card__info">
    <!-- 名称和价格 -->
    <view class="player-card__header">
      <text class="player-card__name">{{player.name}}</text>
      <view class="player-card__price">
        <text class="player-card__price-symbol">¥</text>
        <text class="player-card__price-value">{{player.price}}</text>
        <text class="player-card__price-unit">/hr</text>
      </view>
    </view>
    
    <!-- 评分和订单数 -->
    <view class="player-card__stats">
      <image class="player-card__star" src="/assets/icons/star.svg" />
      <text class="player-card__rating">{{player.rating}}</text>
      <text class="player-card__orders">({{player.orders}} orders)</text>
    </view>
    
    <!-- 标签 -->
    <view class="player-card__tags">
      <view class="player-card__tag player-card__tag--game">{{player.game}}</view>
      <view wx:for="{{player.tags}}" wx:key="*this" wx:if="{{index < 2}}" class="player-card__tag">{{item}}</view>
    </view>
  </view>
</view>
