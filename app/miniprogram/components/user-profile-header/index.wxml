<view class="user-header">
  <!-- Banner（包含状态栏占位） -->
  <view class="banner {{role === 'player' ? 'banner--gold' : ''}}" style="padding-top: {{statusBarHeight}}px;"></view>
  
  <!-- 头像区 -->
  <view class="profile-header">
    <view class="avatar-wrap">
      <image class="avatar" src="https://picsum.photos/100/100?random=1" mode="aspectFill" />
      <view class="avatar-status"></view>
    </view>
    
    <view class="profile-info">
      <view class="profile-name-row">
        <view class="profile-name">
          <text class="name">Nana Chan</text>
          <image wx:if="{{role === 'player'}}" class="star-badge" src="/assets/icons/star.svg" />
        </view>
        <gl-button type="primary" size="small" bindtap="onEditProfile">Edit Profile</gl-button>
      </view>
      <text class="profile-id">nana_chan_88 • #8839</text>
    </view>
  </view>
  
  <!-- 徽章 (Merged into header component for simplicity) -->
  <view class="badges">
    <view class="badge">
      <view class="badge__dot {{role === 'player' ? 'badge__dot--gold' : ''}}"></view>
      <text class="badge__text">{{role === 'player' ? 'COMPANION' : 'GAMER'}}</text>
    </view>
    <view class="badge">
      <image class="badge__icon" src="/assets/icons/mic.svg" />
      <text class="badge__text">MIC ON</text>
    </view>
  </view>
</view>
