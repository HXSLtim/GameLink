<view class="tab-bar">
  <view
    wx:for="{{list}}"
    wx:key="index"
    class="tab-bar__item"
    data-path="{{item.pagePath}}"
    data-index="{{index}}"
    bindtap="switchTab"
  >
    <view class="tab-bar__icon-wrapper">
      <!-- 空心图标（未选中状态） -->
      <image
        class="tab-bar__icon tab-bar__icon--outline {{selected === index ? 'tab-bar__icon--hide' : ''}}"
        src="{{item.icon}}"
        mode="aspectFit"
      />
      <!-- 实心图标（选中状态） -->
      <image
        class="tab-bar__icon tab-bar__icon--filled {{selected === index ? 'tab-bar__icon--show' : ''}} {{animatingIndex === index ? 'tab-bar__icon--fill-anim' : ''}}"
        src="{{item.iconActive}}"
        mode="aspectFit"
      />
    </view>
  </view>
</view>
