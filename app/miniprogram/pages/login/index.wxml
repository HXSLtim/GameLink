<gl-navbar title="登录" showBack="{{true}}"></gl-navbar>

<view class="page page-enter">
  <view class="login-container">
    <!-- Logo -->
    <view class="login-logo">
      <view class="login-logo__icon">🎮</view>
      <text class="login-logo__name">GameLink</text>
      <text class="login-logo__slogan">游戏陪玩，快乐加倍</text>
    </view>
    
    <!-- 登录按钮 -->
    <view class="login-actions">
      <gl-button
        type="primary"
        size="large"
        block
        loading="{{loading}}"
        bindtap="handleWxLogin"
      >微信一键登录</gl-button>
      
      <view class="login-agreement">
        <view class="login-agreement__checkbox {{agreed ? 'login-agreement__checkbox--checked' : ''}}" bindtap="handleAgreeToggle"></view>
        <text class="login-agreement__text">
          登录即表示同意
          <text class="login-agreement__link" bindtap="handleUserAgreement">《用户协议》</text>
          和
          <text class="login-agreement__link" bindtap="handlePrivacyPolicy">《隐私政策》</text>
        </text>
      </view>
    </view>
  </view>
</view>
