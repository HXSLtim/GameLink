<view class="page" style="padding-top: {{navPadding}}px;">
  <!-- 页面标题 -->
  <view class="page-header">
    <text class="page-title">DIRECT MESSAGES</text>
    <image class="header-icon" src="/assets/icons/edit.svg" mode="aspectFit" bindtap="onNewMessage" />
  </view>

  <!-- 未登录状态 -->
  <gl-empty 
    wx:if="{{!isLoggedIn}}" 
    icon="/assets/icons/message.svg"
    title="Sign in to view messages"
    description="Connect with players and manage your conversations"
    showAction
    actionText="Sign In"
    bind:action="handleLogin"
  />
  
  <!-- 加载中 -->
  <gl-loading wx:elif="{{loading}}" text="Loading..." />
  
  <!-- 消息列表 -->
  <view wx:elif="{{conversations.length > 0}}" class="message-list">
    <message-item
      wx:for="{{conversations}}"
      wx:key="id"
      message="{{item}}"
      bind:tap="handleConversationTap"
    />
  </view>
  
  <!-- 空状态 -->
  <gl-empty 
    wx:else 
    icon="/assets/icons/message.svg"
    title="No messages yet"
    description="Start a conversation with a player"
  />
</view>
