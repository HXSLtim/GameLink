<gl-navbar title="陪玩师详情"></gl-navbar>

<view class="page">
  <view wx:if="{{loading}}" class="loading">
    <view class="loading__spinner"></view>
  </view>
  
  <block wx:else>
    <!-- 基本信息 -->
    <view class="player-header">
      <gl-avatar src="{{player.avatar}}" size="xlarge" online="{{player.online}}" placeholder="{{player.nickname[0]}}"></gl-avatar>
      <view class="player-header__info">
        <view class="player-header__name">
          <text>{{player.nickname}}</text>
          <view wx:if="{{player.verified}}" class="player-header__verified">✓</view>
        </view>
        <view class="player-header__meta">
          <text>Lv.{{player.level}}</text>
          <text class="player-header__divider">|</text>
          <text>接单 {{player.orderCount}}</text>
        </view>
        <view class="player-header__tags">
          <gl-tag wx:for="{{player.games}}" wx:key="*this" type="primary" size="small">{{item}}</gl-tag>
        </view>
      </view>
    </view>
    
    <!-- 评分 -->
    <gl-card class="rating-card">
      <view class="rating-content">
        <view class="rating-score">
          <text class="rating-score__value">{{player.rating}}</text>
          <text class="rating-score__label">综合评分</text>
        </view>
        <view class="rating-stats">
          <view class="rating-stat">
            <text class="rating-stat__value">{{player.responseRate}}%</text>
            <text class="rating-stat__label">响应率</text>
          </view>
          <view class="rating-stat">
            <text class="rating-stat__value">{{player.completionRate}}%</text>
            <text class="rating-stat__label">完成率</text>
          </view>
        </view>
      </view>
    </gl-card>
    
    <!-- 简介 -->
    <gl-card title="个人简介">
      <text class="intro-text">{{player.intro || '这个人很懒，什么都没写~'}}</text>
    </gl-card>
    
    <!-- 服务项目 -->
    <gl-card title="服务项目">
      <view class="service-list">
        <view wx:for="{{player.services}}" wx:key="id" class="service-item">
          <view class="service-item__info">
            <text class="service-item__name">{{item.name}}</text>
            <text class="service-item__desc">{{item.description}}</text>
          </view>
          <view class="service-item__price">
            <text class="service-item__price-value">¥{{item.price}}</text>
            <text class="service-item__price-unit">/{{item.unit}}</text>
          </view>
        </view>
      </view>
    </gl-card>
  </block>
</view>

<!-- 底部操作栏 -->
<view class="bottom-bar safe-area-bottom">
  <view class="bottom-bar__price">
    <text class="bottom-bar__price-label">起步价</text>
    <text class="bottom-bar__price-value">¥{{player.price}}</text>
  </view>
  <gl-button type="cta" size="large" bindtap="handleOrder">立即下单</gl-button>
</view>
