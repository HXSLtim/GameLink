<gl-navbar title="我的订单"></gl-navbar>

<view class="page">
  <!-- 状态筛选 -->
  <scroll-view class="status-tabs" scroll-x enhanced show-scrollbar="{{false}}">
    <view
      wx:for="{{statusTabs}}"
      wx:key="value"
      class="status-tab {{activeStatus === item.value ? 'status-tab--active' : ''}}"
      bindtap="handleStatusTap"
      data-status="{{item.value}}"
    >{{item.label}}</view>
  </scroll-view>
  
  <view wx:if="{{loading}}" class="loading">
    <view class="loading__spinner"></view>
  </view>
  
  <block wx:elif="{{orders.length > 0}}">
    <view
      wx:for="{{orders}}"
      wx:key="id"
      class="order-item"
      hover-class="order-item--hover"
      bindtap="handleOrderTap"
      data-id="{{item.id}}"
    >
      <view class="order-item__header">
        <text class="order-item__no">{{item.orderNo}}</text>
        <gl-tag type="{{statusMap[item.status].type}}" size="small">{{statusMap[item.status].text}}</gl-tag>
      </view>
      <view class="order-item__content">
        <gl-avatar src="{{item.player.avatar}}" size="medium" placeholder="{{item.player.nickname[0]}}"></gl-avatar>
        <view class="order-item__info">
          <text class="order-item__name">{{item.player.nickname}}</text>
          <text class="order-item__service">{{item.service.name}} x{{item.quantity}}</text>
        </view>
        <view class="order-item__price">¥{{item.totalPrice}}</view>
      </view>
      <view class="order-item__footer">
        <text class="order-item__time">{{item.createdAt}}</text>
      </view>
    </view>
  </block>
  
  <view wx:else class="empty">
    <text class="empty__text">暂无订单</text>
  </view>
</view>
