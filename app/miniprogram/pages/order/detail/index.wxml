<gl-navbar title="订单详情"></gl-navbar>

<view class="page">
  <view wx:if="{{loading}}" class="loading">
    <view class="loading__spinner"></view>
  </view>
  
  <block wx:else>
    <!-- 订单状态 -->
    <gl-card>
      <view class="order-status">
        <text class="order-status__text">{{order.statusText}}</text>
        <gl-tag type="{{statusMap[order.status].type}}">{{statusMap[order.status].text}}</gl-tag>
      </view>
    </gl-card>
    
    <!-- 陪玩师信息 -->
    <gl-card title="陪玩师">
      <view class="player-info">
        <gl-avatar src="{{order.player.avatar}}" size="large" placeholder="{{order.player.nickname[0]}}"></gl-avatar>
        <view class="player-info__content">
          <text class="player-info__name">{{order.player.nickname}}</text>
          <text class="player-info__service">{{order.service.name}}</text>
        </view>
      </view>
    </gl-card>
    
    <!-- 订单信息 -->
    <gl-card title="订单信息">
      <view class="order-info">
        <view class="info-row">
          <text class="info-row__label">订单编号</text>
          <text class="info-row__value">{{order.orderNo}}</text>
        </view>
        <view class="info-row">
          <text class="info-row__label">服务项目</text>
          <text class="info-row__value">{{order.service.name}}</text>
        </view>
        <view class="info-row">
          <text class="info-row__label">单价</text>
          <text class="info-row__value">¥{{order.service.price}}/{{order.service.unit}}</text>
        </view>
        <view class="info-row">
          <text class="info-row__label">数量</text>
          <text class="info-row__value">{{order.quantity}}{{order.service.unit}}</text>
        </view>
        <view class="info-row">
          <text class="info-row__label">下单时间</text>
          <text class="info-row__value">{{order.createdAt}}</text>
        </view>
        <view class="info-row info-row--total">
          <text class="info-row__label">订单金额</text>
          <text class="info-row__value">¥{{order.totalPrice}}</text>
        </view>
      </view>
    </gl-card>
    
    <!-- 备注 -->
    <gl-card wx:if="{{order.remark}}" title="订单备注">
      <text class="remark-text">{{order.remark}}</text>
    </gl-card>
  </block>
</view>

<!-- 底部操作栏 -->
<view class="bottom-bar safe-area-bottom">
  <block wx:if="{{order.status === 'pending'}}">
    <gl-button type="secondary" size="large" bindtap="handleCancel">取消订单</gl-button>
    <gl-button type="cta" size="large" bindtap="handlePay">立即支付</gl-button>
  </block>
  <block wx:elif="{{order.status === 'processing'}}">
    <gl-button type="primary" size="large" block bindtap="handleContact">联系陪玩师</gl-button>
  </block>
</view>
