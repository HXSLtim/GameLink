# GameLink User App - Environment Variables Template
# Copy this file to .env and adjust values for your environment.

# Backend API base URL
# Development suggested value: http://localhost:8080/api/v1
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Runtime error monitoring (Sentry-compatible global SDK)
VITE_ENABLE_ERROR_MONITORING=false
VITE_SENTRY_DSN=
VITE_SENTRY_RELEASE=0.1.0
VITE_SENTRY_ENVIRONMENT=development
